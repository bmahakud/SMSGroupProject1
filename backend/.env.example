# PostgreSQL Database Configuration
# Set DATABASE_URL or environment variables to connect to PostgreSQL in local/staging/production

# Option 1: Direct PostgreSQL Connection URL (e.g. Supabase, Render, Neon, ElephantSQL, Heroku, RDS)
# DATABASE_URL=postgres://sms_user:sms_password@localhost:5432/sms_db

# Option 2: Individual Environment Variables
USE_POSTGRES=true
POSTGRES_DB=sms_db
POSTGRES_USER=sms_user
POSTGRES_PASSWORD=sms_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
